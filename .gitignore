# ====================
# Python 编译产物
# ====================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ====================
# 虚拟环境
# ====================
.venv/
venv/
env/
ENV/

# ====================
# 环境变量（含 API Key，绝对不能提交！）
# ====================
.env
.env.*
!.env.example

# ====================
# uv 锁文件（体积大，由 pyproject.toml 自动生成）
# ====================
uv.lock

# ====================
# IDE 配置（JetBrains / VSCode）
# ====================
.idea/
.vscode/
*.iml

# ====================
# Jupyter Notebook 检查点
# ====================
.ipynb_checkpoints/
*.ipynb

# ====================
# macOS 系统文件
# ====================
.DS_Store
.AppleDouble
.LSOverride

# ====================
# 日志 & 临时文件
# ====================
*.log
*.tmp
*.swp
*.swo

# ====================
# 构建 & 分发产物
# ====================
dist/
build/
*.egg-info/
*.egg
